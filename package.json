{
  "name": "@otea/cli",
  "version": "0.2.0",
  "description": "The asynchronous handoff surface between you and your AI agents.",
  "license": "AGPL-3.0-only",
  "author": "Federico Daniel Ara",
  "homepage": "https://github.com/otea-dev/otea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otea-dev/otea.git"
  },
  "bugs": {
    "url": "https://github.com/otea-dev/otea/issues"
  },
  "type": "module",
  "bin": {
    "otea": "bin/otea.mjs"
  },
  "files": [
    "bin",
    "dist",
    "ui/dist",
    "presets",
    "schemas",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "build:ui": "vite build ui",
    "dev:ui": "vite ui",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:ui && npm run build",
    "prepack": "npm run build:ui && npm run build",
    "otea": "node --disable-warning=ExperimentalWarning src/cli/main.ts",
    "demo:gifs": "node scripts/demo/gifs.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "micromark": "4.0.3",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.19",
    "uqr": "0.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
